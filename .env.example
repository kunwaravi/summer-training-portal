# ========================================
# DATABASE CONFIGURATION
# ========================================
# Local Docker DB: postgresql://nexusadmin:nexuspassword@db:5432/nexus?schema=public
# Production DB: postgresql://[user]:[password]@[host]:[port]/[db_name]?schema=public
DATABASE_URL=postgresql://nexusadmin:nexuspassword@db:5432/nexus?schema=public

# ========================================
# REDIS CONFIGURATION (Phase 2 Cache)
# ========================================
# Local Docker Redis: redis://redis:6379
# Production Redis (Upstash/Aiven): rediss://default:[password]@[host]:[port]
REDIS_URL=redis://redis:6379

# ========================================
# BACKEND API SERVER
# ========================================
PORT=5000
NODE_ENV=development

# JWT Secret for Session Auth (MUST BE LONG AND SECURE IN PRODUCTION)
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# CORS Origin (Frontend URL)
# Local: http://localhost:5173
# Production: https://edunexus.in
CORS_ORIGIN=http://localhost:5173

# Payment Webhook Secret (Razorpay/Stripe validation)
PAYMENT_WEBHOOK_SECRET=whsec_dummy_secret_for_local_dev

# ========================================
# FRONTEND VITE CONFIGURATION
# ========================================
# Vite requires VITE_ prefix to expose variables to the browser
# Local Backend: http://localhost:5000/api
# Production Backend: https://api.edunexus.in/api
VITE_API_URL=http://localhost:5000/api
