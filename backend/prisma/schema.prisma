generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            Int              @id @default(autoincrement())
  email         String           @unique
  password      String
  name          String
  fatherName    String?
  collegeName   String?
  branchName    String?
  grade         String?          @default("N/A")
  progress      Int              @default(0) // legacy global progress
  weekCompleted Int              @default(0) // legacy global weekCompleted
  courseType    String           @default("Electronics")
  role          Role             @default(USER)
  progresses    CourseProgress[]
  results       QuizResult[]
  payments      Payment[]
  createdAt     DateTime         @default(now())
}

model CourseProgress {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String   // "C", "C++", "IoT", "Embedded"
  course        Course   @relation(fields: [courseId], references: [id])
  weekCompleted Int      @default(0) // 0 to 4
  progress      Int      @default(0) // 0 to 100
  completed     Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

model QuizResult {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String   @default("C")
  course    Course   @relation(fields: [courseId], references: [id])
  week      Int
  score     Int
  passed    Boolean
  createdAt DateTime @default(now())

  @@index([userId, courseId])
}

model Course {
  id          String           @id // "C", "C++", "IoT", "Embedded"
  title       String
  description String
  price       Int              @default(999) // Price in rupees
  isPublished Boolean          @default(true)
  modules     Module[]
  progresses  CourseProgress[]
  results     QuizResult[]
  payments    Payment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Module {
  id            Int            @id @default(autoincrement())
  courseId      String
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  week          Int
  title         String
  description   String
  topics        Topic[]
  quizQuestions QuizQuestion[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([courseId, week])
  @@index([courseId])
}

model Topic {
  id          Int      @id @default(autoincrement())
  moduleId    Int
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  text        String
  code        String?
  note        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([moduleId])
}

model QuizQuestion {
  id            Int      @id @default(autoincrement())
  moduleId      Int
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  text          String
  options       String
  correctAnswer String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([moduleId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id            String        @id @default(uuid())
  userId        Int
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course        @relation(fields: [courseId], references: [id])
  transactionId String?       @unique
  amount        Int
  status        PaymentStatus @default(PENDING)
  reference     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, courseId])
}
